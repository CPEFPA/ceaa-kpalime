generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PEDAGOGIC_MANAGER
  TRAINER
  EVALUATOR
  CANDIDATE
  LEARNER
  INSTITUTION
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  TEST_SCHEDULED
  TEST_DONE
  EVALUATED
  ADMITTED
  REJECTED
  REORIENTED
  VALIDATED
}

enum TestStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EvaluationLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PERFECTING
}

enum CommuneRequestStatus {
  DRAFT
  NEEDS_ANALYSIS
  PROGRAM_DEFINED
  VALIDATED
  IN_PROGRESS
  COMPLETED
}

enum DevoirStatut {
  A_RENDRE
  RENDU
  CORRIGE
  EN_RETARD
}

enum CoursType {
  VIDEO
  PDF
  AUDIO
  EXERCICE
}

enum EvenementType {
  COURS
  DEVOIR
  EXAMEN
  REPETITION
  EVENEMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CANDIDATE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidate    Candidate?
  learner      Learner?
  trainer      Trainer?
  commune      Commune?
  
  applications Application[]
  notifications Notification[]
  documents    Document[]
}

model Candidate {
  id               String        @id @default(cuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  birthDate        DateTime?
  gender           String?
  nationality      String?
  city             String?
  address          String?
  educationLevel   String?
  school           String?
  currentStatus    String?
  mainInstrumentId String?
  mainInstrument   Instrument?   @relation(fields: [mainInstrumentId], references: [id])
  levelEstimated   String?
  yearsPractice    Int?
  experience       String?
  applications     Application[]
}

model Learner {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  instrument       String
  level            String
  group            String
  trainerId        String?
  trainer          Trainer? @relation(fields: [trainerId], references: [id])
  progression      Int      @default(0)
  admissionDate    DateTime @default(now())
  
  courses          LearnerCourse[]
  devoirs          LearnerDevoir[]
  presences        Presence[]
}

model Trainer {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  specialty   String
  groups      String[]
  
  learners    Learner[]
  courses     Course[]
  evaluations Evaluation[]
}

model Training {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  description       String
  targetAudience    String
  requiredLevel     String?
  duration          String?
  modality          String
  requiresMusicTest Boolean          @default(true)
  applications      Application[]
  modules           TrainingModule[]
}

model Module {
  id          String           @id @default(cuid())
  code        String           @unique
  title       String
  description String
  category    String
  trainings   TrainingModule[]
}

model TrainingModule {
  trainingId String
  moduleId   String
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([trainingId, moduleId])
}

model Instrument {
  id         String        @id @default(cuid())
  name       String        @unique
  candidates Candidate[]
  tests      MusicTest[]
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  candidateId String?
  trainingId  String
  status      ApplicationStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id])
  candidate   Candidate?        @relation(fields: [candidateId], references: [id])
  training    Training          @relation(fields: [trainingId], references: [id])
  musicTests  MusicTest[]
}

model MusicTest {
  id            String       @id @default(cuid())
  applicationId String
  instrumentId  String
  scheduledAt   DateTime?
  location      String?
  evaluatorId   String?
  status        TestStatus   @default(SCHEDULED)

  application   Application  @relation(fields: [applicationId], references: [id])
  instrument    Instrument   @relation(fields: [instrumentId], references: [id])
  evaluation    Evaluation?
}

model Evaluation {
  id             String           @id @default(cuid())
  testId         String           @unique
  test           MusicTest        @relation(fields: [testId], references: [id])
  evaluatorId    String?
  evaluator      Trainer?         @relation(fields: [evaluatorId], references: [id])
  technicalLevel Int?
  pitch          Int?
  rhythm         Int?
  sightReading   Int?
  ear            Int?
  interpretation Int?
  expression     Int?
  motivation     Int?
  experience     Int?
  observations   String?
  proposedLevel  EvaluationLevel?
  finalLevel     EvaluationLevel?
  createdAt      DateTime         @default(now())
}

model Commune {
  id          String           @id @default(cuid())
  userId      String           @unique
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  region      String?
  prefecture  String?
  contactName String?
  contactRole String?
  phone       String?
  email       String?
  requests    CommuneRequest[]
}

model CommuneRequest {
  id        String               @id @default(cuid())
  communeId String
  domain    String
  needs     String
  status    CommuneRequestStatus @default(DRAFT)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  commune   Commune              @relation(fields: [communeId], references: [id])
}

model Course {
  id          String      @id @default(cuid())
  title       String
  description String
  type        CoursType
  module      String
  duration    String
  publishDate DateTime    @default(now())
  url         String
  trainerId   String?
  trainer     Trainer?    @relation(fields: [trainerId], references: [id])
  
  learners    LearnerCourse[]
  devoirs     Devoir[]
}

model LearnerCourse {
  id         String   @id @default(cuid())
  learnerId  String
  courseId   String
  progression Int     @default(0)
  completed   Boolean @default(false)
  
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([learnerId, courseId])
}

model Devoir {
  id          String        @id @default(cuid())
  title       String
  courseId    String
  description String
  dueDate     DateTime
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  submissions LearnerDevoir[]
}

model LearnerDevoir {
  id          String        @id @default(cuid())
  learnerId   String
  devoirId    String
  status      DevoirStatut  @default(A_RENDRE)
  submittedAt DateTime?
  note        Int?
  appreciation String?
  
  learner     Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  devoir      Devoir        @relation(fields: [devoirId], references: [id], onDelete: Cascade)
  
  @@unique([learnerId, devoirId])
}

model Evenement {
  id          String         @id @default(cuid())
  title       String
  date        DateTime
  startTime   String
  duration    String
  location    String
  type        EvenementType
  description String?
}

model Presence {
  id          String   @id @default(cuid())
  learnerId   String
  courseId    String
  date        DateTime @default(now())
  status      String   @default("PRESENT")
  
  learner     Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  
  @@unique([learnerId, date])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  name      String
  path      String
  type      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}